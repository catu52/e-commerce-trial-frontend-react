# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Browser-facing URL of the Laravel API (must be reachable from the browser, not the container).
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# VITE_SITE_URL: Public origin of the storefront, used for canonical URLs, Open Graph and JSON-LD.
VITE_SITE_URL="http://localhost:3000"
